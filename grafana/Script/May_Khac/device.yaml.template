# ============================================================
# device.yaml.template - TEMPLATE CẤU HÌNH THIẾT BỊ
# ============================================================
# 
# HƯỚNG DẪN SỬ DỤNG:
# 1. Copy file này thành device.yaml:
#    cp device.yaml.template device.yaml
#
# 2. Thay đổi các giá trị sau cho phù hợp với máy của bạn:
#    - device.id: Tên máy duy nhất (vd: may-01, server-prod, devbox)
#    - central_catalog.host: IP máy chủ trung tâm
#    - influxdb.url: URL InfluxDB server
#    - postgresql: Cấu hình nếu máy có PostgreSQL
#
# 3. Export InfluxDB token:
#    export INFLUX_TOKEN='your_influx_write_token_here'
#
# 4. Chạy cài đặt:
#    sudo -E ./install-agent-v2.sh --config device.yaml
#
# ============================================================

schema_version: 2

# ============================================================
# 1. ĐỊNH DANH THIẾT BỊ
# ============================================================
device:
  # ID thiết bị: Điền 'auto' để tự động lấy tên máy (hostname -s),
  # hoặc đặt tên tùy chỉnh (vd: may-cnc-01, robot-02, devbox)
  id: auto
  
  # Tên hiển thị (auto = tự động lấy hostname)
  name: auto
  
  # Mô tả thiết bị (tùy chọn)
  description: "Thiết bị giám sát hệ thống & cơ sở dữ liệu"
  
  # Vị trí vật lý (tùy chọn)
  location: "DataCenter-01"

# ============================================================
# 2. KẾT NỐI MÁY CHỦ INFLUXDB TRUNG TÂM
# ============================================================
influxdb:
  # Bật/tắt gửi metrics lên InfluxDB
  enabled: true
  
  # URL máy chủ InfluxDB (Thay thế bằng IP máy chủ của bạn)
  # Ví dụ: url: "http://192.168.1.53:8086" hoặc "http://localhost:8086"
  url: "http://192.168.1.100:8086"
  
  # Organization trong InfluxDB
  organization: "monitoring"
  
  # Tên biến môi trường chứa token (không hardcode token vào file)
  token_env: "INFLUX_TOKEN"
  
  # Buckets lưu trữ (mặc định - thường không cần thay đổi)
  buckets:
    system: "system_metrics"
    csv: "device_csv"
    database: "device_database"

# ============================================================
# 3. KẾT NỐI KHO METADATA ERD TẬP TRUNG
# ============================================================
central_catalog:
  # IP máy chủ PostgreSQL chứa monitoring_catalog (Thay bằng IP máy A)
  # Ví dụ: host: "192.168.1.53" hoặc "localhost"
  host: "192.168.1.100"
  
  # Port PostgreSQL
  port: 5432
  
  # Username
  user: "grafana_reader"
  
  # Password (nên đổi password này trong production)
  password: "1"
  
  # Database name
  database: "monitoring_catalog"

# ============================================================
# 4. CẤU HÌNH TELEGRAF AGENT
# ============================================================
agent:
  # Tần suất thu thập metrics (10s = mỗi 10 giây)
  interval: "10s"
  
  # Tần suất gửi dữ liệu lên InfluxDB
  flush_interval: "10s"

# ============================================================
# 5. GIÁM SÁT TÀI NGUYÊN HỆ THỐNG
# ============================================================
monitoring:
  system:
    # Bật/tắt toàn bộ giám sát hệ thống
    enabled: true
    
    # Thu thập CPU metrics
    cpu: true
    
    # Thu thập RAM metrics
    memory: true
    
    # Thu thập Disk usage
    disk: true
    
    # Thu thập Disk I/O
    diskio: true
    
    # Thu thập Network traffic
    network: true
    
    # Thu thập System uptime
    uptime: true
    
    # Thu thập Process count
    processes: true
  
  heartbeat:
    # Gửi tín hiệu "còn sống" định kỳ
    enabled: true
    
    # Tần suất gửi heartbeat
    interval: "10s"

# ============================================================
# 6. GIÁM SÁT POSTGRESQL & VẼ SƠ ĐỒ ERD (Tùy chọn)
# ============================================================
# Hỗ trợ tự động khám phá nhiều Database hoặc danh sách Database cụ thể
postgresql:
  # Bật/tắt giám sát PostgreSQL
  enabled: true
  
  # Danh sách các PostgreSQL instances
  instances:
    - name: "pg_instance_1"
      host: "localhost"                 # localhost hoặc IP máy chứa DB (ví dụ: 192.168.1.60)
      port: 5432
      username: "postgres"
      password: "1"                     # Mật khẩu user postgres
      databases:
        - "auto"                        # "auto": Tự động phát hiện toàn bộ Database người dùng
        # Hoặc liệt kê cụ thể:
        # - "app_db"
        # - "order_db"
      sslmode: "disable"

# ============================================================
# 7. GIÁM SÁT FILE CSV (Tùy chọn)
# ============================================================
# Hỗ trợ quét thư mục (paths) HOẶC khai báo từng file cụ thể (files)
csv:
  # Bật/tắt giám sát file CSV
  enabled: true
  
  # Tần suất đọc dữ liệu CSV
  interval: "1m"
  
  # CÁCH 1 (Khuyên dùng): Tự động quét toàn bộ file *.csv trong thư mục
  paths:
    - "/path/to/your/data/*.csv"
    # Ví dụ thực tế:
    # - "/home/user/my_csv_data/*.csv"
    # - "/var/log/sensor_data/*.csv"

  # CÁCH 2: Khai báo từng tệp CSV cụ thể (nếu muốn cấu hình riêng biệt)
  # files:
  #   - name: "sales_report"
  #     path: "/path/to/sales_report.csv"
  #     header: true
  #     delimiter: ","

# ============================================================
# 8. GIÁM SÁT DOCKER (Tùy chọn)
# ============================================================
docker:
  # auto = tự động phát hiện Docker
  # true = bắt buộc bật
  # false = tắt
  enabled: auto
  
  # Docker socket endpoint
  endpoint: "unix:///var/run/docker.sock"
  
  # Cấp quyền truy cập Docker socket cho telegraf user
  # WARNING: Điều này cấp quyền root-equivalent
  grant_socket_access: false
  
  # Lọc containers theo tên (tùy chọn)
  container_name_include: []

# ============================================================
# 9. GIÁM SÁT SYSTEMD SERVICES (Tùy chọn)
# ============================================================
applications:
  # auto = tự động phát hiện services đang chạy
  # true = bật với danh sách chỉ định
  # false = tắt
  enabled: auto
  
  # Danh sách systemd services cần giám sát (nếu không dùng auto)
  systemd_services: []
    # VÍ DỤ:
    # - "ssh.service"
    # - "docker.service"
    # - "nginx.service"
    # - "postgresql.service"

# ============================================================
# LƯU Ý QUAN TRỌNG:
# ============================================================
# 1. GPU (NVIDIA): Tự động phát hiện nếu có nvidia-smi
# 2. Token InfluxDB: Phải export trước khi chạy script
#    export INFLUX_TOKEN='your_token_here'
# 3. PostgreSQL ERD: Chạy python3 manage.py collect device.yaml
#    để thu thập metadata ERD lần đầu
# 4. Cron job: Thiết lập cron để tự động cập nhật ERD:
#    */5 * * * * cd /path/to/grafana && python3 manage.py collect device.yaml
# 5. Kiểm tra cấu hình trước khi cài:
#    sudo ./install-agent-v2.sh --validate-only --config device.yaml
# 6. Xem cấu hình Telegraf được sinh ra:
#    sudo ./install-agent-v2.sh --render-only test.conf --config device.yaml
# ============================================================

# ============================================================
# CÁC USE CASE PHỔ BIẾN:
# ============================================================
#
# USE CASE 1: Máy chủ production không có database
# -------------------------------------------------------
# device:
#   id: "prod-server-01"
# influxdb:
#   enabled: true
# postgresql:
#   enabled: false
# docker:
#   enabled: auto
# applications:
#   enabled: auto
#
# USE CASE 2: Máy phát triển có PostgreSQL
# -------------------------------------------------------
# device:
