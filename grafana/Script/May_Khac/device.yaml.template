# influxdb:
#   enabled: true
# postgresql:
#   enabled: true
#   instances:
#     - name: "local_dev"
#       host: "localhost"
#       databases: ["dev_db", "test_db"]
#
# USE CASE 3: Chỉ thu thập ERD remote (không cần metrics)
